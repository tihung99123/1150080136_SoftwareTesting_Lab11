<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Bai3 - Smoke Suite" verbose="1">
    <parameter name="browser" value="chrome"/>
    <parameter name="env" value="dev"/>

    <test name="Excel Login Smoke Tests">
        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>
        <classes>
            <class name="com.lab9.bai3.LoginExcelTest"/>
        </classes>
    </test>
</suite>